@model LevelUp.BLL.Services.Rooms.ViewModel.RoomIndexViewModel
@{
    ViewData["Title"] = "الغرف";
}

    <div>
      <h1>الغرف</h1>
      <p class="sub">كل الغرف بتشتغل سنجل أو ملتي. النمط الافتراضي هو اللي بيكون متحدد في الكارت أول ما تفتح صفحة الأجهزة.</p>
    </div>

    <section class="panel pad">
      <h2>إضافة غرفة جديدة</h2>
      <form class="form-line" method="post" asp-controller="Room" asp-action="Add" autocomplete="off" novalidate>
        <div class="field f-wide">
          <label for="Name">اسم الغرفة</label>
          <input class="in" id="Name" name="Name" type="text" placeholder="مثلاً: غرفة 12" value="@Model.NewRoom.Name"
                 data-val="true" data-val-required="اكتب اسم الغرفة الأول"
                 data-val-length="اسم الغرفة طويل، أقصى حاجة 50 حرف" data-val-length-max="50">
        </div>
        <div class="field f-mode">
          <label for="DefaultMode">النمط الافتراضي</label>
          <select class="in" id="DefaultMode" name="DefaultMode">
            <option value="Single" selected="@(Model.NewRoom.DefaultMode == GameMode.Single)">سنجل</option>
            <option value="Multi" selected="@(Model.NewRoom.DefaultMode == GameMode.Multi)">ملتي</option>
          </select>
        </div>
        <button class="btn" type="submit">حفظ الغرفة</button>
        <div class="msg-line">
          @Html.ValidationMessage("Name", new { @class = "msg err" })
        </div>
      </form>
      @if (TempData["SuccessMessage"] is string success)
      {
        <span class="msg ok" role="status">@success</span>
      }
      @if (TempData["ErrorMessage"] is string error)
      {
        <span class="msg err" role="status">@error</span>
      }
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2>كل الغرف</h2>
        <span class="muted">@Model.TotalCount غرفة · @Model.ActiveCount مفعّلة · @Model.DisabledCount معطلة</span>
      </div>
      @if (Model.TotalCount == 0)
      {
        <div class="empty">مفيش غرف، ضيف أول غرفة من فوق</div>
      }
      else
      {
      <div class="scroll">
        <table class="t">
          <thead>
            <tr>
              <th>الغرفة</th>
              <th>النمط الافتراضي</th>
              <th>الحالة</th>
              <th>تفعيل / تعطيل</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var room in Model.Rooms)
            {
              var locked = room.IsActive && room.HasOpenSession;
            <tr class="@(room.IsActive ? null : "off")">
              <td class="b">
                @if (Model.EditId == room.Id)
                {
                <div class="acts">
                  <input class="in in-name" form="edit-name-@room.Id" name="Name" type="text" value="@room.Name" aria-label="اسم @room.Name الجديد"
                         data-val="true" data-val-required="اكتب اسم الغرفة">
                  <form id="edit-name-@room.Id" method="post" asp-controller="Room" asp-action="UpdateName" novalidate>
                    <input type="hidden" name="Id" value="@room.Id">
                    <button type="submit" class="btn sm green">حفظ</button>
                  </form>
                  <a class="btn sm ghost-gray" asp-controller="Room" asp-action="Index">إلغاء</a>
                </div>
                }
                else
                {
                <span class="name-cell">@room.Name
                  <a class="btn xs ghost-gray" asp-controller="Room" asp-action="Index" asp-route-editId="@room.Id" title="تعديل اسم @room.Name"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg> تعديل الاسم</a>
                </span>
                }
              </td>
              <td>
                <form class="form-line" method="post" asp-controller="Room" asp-action="UpdateDefaultMode">
                  <input type="hidden" name="Id" value="@room.Id">
                  <select class="in" name="DefaultMode" aria-label="النمط الافتراضي لـ@(room.Name)">
                    <option value="Single" selected="@(room.DefaultMode == GameMode.Single)">سنجل</option>
                    <option value="Multi" selected="@(room.DefaultMode == GameMode.Multi)">ملتي</option>
                  </select>
                  <button type="submit" class="btn sm ghost">حفظ</button>
                </form>
              </td>
              <td>
                @if (!room.IsActive)
                {
                <span class="pill p-red">معطلة</span>
                }
                else if (room.SessionStatus == SessionStatus.Stopped)
                {
                <span class="pill p-amber">في انتظار الحساب</span>
                }
                else if (room.SessionStatus == SessionStatus.Running)
                {
                <span class="pill p-green">شغالة @TextHelpers.ModeText(room.CurrentMode ?? room.DefaultMode)</span>
                }
                else
                {
                <span class="pill p-gray">فاضية</span>
                }
              </td>
              <td>
                <div class="acts">
                  <form method="post" asp-controller="Room" asp-action="ToggleActive">
                    <input type="hidden" name="Id" value="@room.Id">
                    @if (room.IsActive)
                    {
                    <button type="submit" class="btn sm ghost-red" disabled="@locked">تعطيل الغرفة</button>
                    }
                    else
                    {
                    <button type="submit" class="btn sm ghost-green">تفعيل الغرفة</button>
                    }
                  </form>
                  @if (locked)
                  {
                  <span class="note-xs">فيها جلسة شغالة</span>
                  }
                </div>
              </td>
            </tr>
            }
          </tbody>
        </table>
      </div>
      }
    </section>
