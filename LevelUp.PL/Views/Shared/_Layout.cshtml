@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsOn(string controller, string? action = null) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && (action is null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase));

    string? Current(bool on) => on ? "page" : null;

    var singleOn = IsOn("Dashboard", "Single");
    var multiOn = IsOn("Dashboard", "Multi");
    var deviceOn = IsOn("Device");
    var sessionOn = IsOn("Session");
    var drinkOn = IsOn("Drink");
    var roomOn = IsOn("Room");

    var runningCount = ViewData["RunningCount"] as int? ?? 0;

    var userName = User.Identity?.Name ?? string.Empty;
    var avatar = userName.Length > 0 ? userName[..1] : string.Empty;
}
<!doctype html>
<html lang="ar" dir="rtl" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@ViewData["Title"] · LEVEL UP</title>
<link rel="icon" type="image/svg+xml" href="~/images/favicon.svg">
<link rel="stylesheet" href="~/css/bootstrap.rtl.min.css">
<link rel="stylesheet" href="~/css/style.css">
<script src="~/js/theme.js"></script>
</head>
<body>
<div class="shell">

  <nav class="sidebar" aria-label="القائمة الرئيسية">
    <div class="brand">
      <div class="logo"><img src="~/images/logo.svg" alt="" width="24" height="24"></div>
      <div><b>LEVEL UP</b><small>إدارة البلايستيشن</small></div>
    </div>

    <div class="nav-links">
      <div class="nav-group">
        <div class="nav-sec">اللوحات</div>
        <a class="item@(singleOn ? " on" : "")" asp-controller="Dashboard" asp-action="Single" aria-current="@Current(singleOn)">
          <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span class="lbl">لوحة السنجل</span>
        </a>
        <a class="item@(multiOn ? " on multi" : "")" asp-controller="Dashboard" asp-action="Multi" aria-current="@Current(multiOn)">
          <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span class="lbl">لوحة الملتي</span>
        </a>
      </div>
      <div class="nav-group">
        <div class="nav-sec">التشغيل</div>
        <a class="item@(deviceOn ? " on" : "")" asp-controller="Device" asp-action="Index" aria-current="@Current(deviceOn)">
          <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
          <span class="lbl">الأجهزة</span>
          @if (runningCount > 0)
          {
            <span class="cnt">@runningCount شغال</span>
          }
        </a>
        <a class="item@(sessionOn ? " on" : "")" asp-controller="Session" asp-action="Index" aria-current="@Current(sessionOn)">
          <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l3 2"/></svg>
          <span class="lbl">الجلسات المنتهية</span>
        </a>
      </div>
      <div class="nav-group">
        <div class="nav-sec">الإعدادات</div>
        <a class="item@(drinkOn ? " on" : "")" asp-controller="Drink" asp-action="Index" aria-current="@Current(drinkOn)">
          <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 8h1a4 4 0 0 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z"/><path d="M6 2v2M10 2v2M14 2v2"/></svg>
          <span class="lbl">المشروبات</span>
        </a>
        <a class="item@(roomOn ? " on" : "")" asp-controller="Room" asp-action="Index" aria-current="@Current(roomOn)">
          <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
          <span class="lbl">الغرف</span>
        </a>
      </div>
    </div>

    <div class="nav-foot">
      <div class="who">
        <span class="av">@avatar</span>
        <div><b>@userName</b>مدير النظام</div>
      </div>
      <button type="button" class="theme-toggle" id="themeToggle" aria-label="تفعيل الوضع الفاتح" title="تفعيل الوضع الفاتح">
        <span class="theme-icon when-dark"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span>
        <span class="lbl when-dark">الوضع الفاتح</span>
        <span class="theme-icon when-light"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg></span>
        <span class="lbl when-light">الوضع الداكن</span>
      </button>
      <form method="post" asp-controller="Account" asp-action="Logout">
        <button type="submit" class="btn sm ghost-red" title="تسجيل الخروج">
          <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5M21 12H9"/></svg>
          <span class="lbl">تسجيل الخروج</span>
        </button>
      </form>
    </div>
  </nav>

  <main class="main">
    @RenderBody()
  </main>
</div>

<script src="~/js/jquery.min.js"></script>
<script src="~/js/jquery.validate.min.js"></script>
<script src="~/js/jquery.validate.unobtrusive.min.js"></script>
<script src="~/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
